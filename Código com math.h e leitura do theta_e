#define TS         100e-6f
#define RS         16.0f
#define LQ         0.018f
#define NP         18.0f
#define VMAX_MPC   430.0f
#define ALPHA_DC   0.995f
#define ALPHA_REF  0.995f
#define M_PI_F     3.14159265f
#define IMAX_MPC   7.0f
#define WMAX_MPC   100.0f

