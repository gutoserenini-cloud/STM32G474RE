// 1. LIGA O PINO NO EXATO MOMENTO EM QUE O TIMER MANDA O ADC INICIAR A LEITURA
// ==============================================================================
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
    if (htim->Instance == TIM6) {
        // O ADC e o DMA começam a trabalhar fisicamente neste milissegundo
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_15, GPIO_PIN_SET);
        // 2. DISPARA O ADC E O DMA MANUALMENTE
        HAL_ADC_Start_DMA(&hadc1, (uint32_t*)vetor_adc_bruto, 6);
    }
}

// LOOP DE CONTROLE PRINCIPAL (10 kHz via DMA ADC)
void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc) {
    if(hadc->Instance == ADC1) {

        // ==============================================================================
        // 2. DESLIGA O PINO IMEDIATAMENTE (O DMA terminou de preencher o vetor bruto)
        // ==============================================================================
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_15, GPIO_PIN_RESET);

        // Verifica o sinal de "Start" do SCADA da Typhoon no Pino PC13
        if (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_SET) {
            // MODO: RODANDO (SIMULAÇÃO ATIVA)
            // 1. LED Heartbeat Lento (Pisca a cada 500ms = 5000 ciclos)
            static uint32_t contador_led_run = 0;
            contador_led_run++;
            if(contador_led_run >= 5000) {
                HAL_GPIO_TogglePin(GPIOA, GPIO_PIN_5);
                contador_led_run = 0;
            }
            // 2. Leituras
            Leitura_Sensores_HIL();
            float ia_med = hil_ia;
            float ib_med = hil_ib;
            // 3. Perfil de Referência e Filtro
            wm_ref_f = ALPHA_REF * wm_ref_f + (1.0f - ALPHA_REF) * hil_wref;
            float we_ref_f = NP * wm_ref_f;
            float we_feedback = hil_w_med * NP;
            float theta_feedback = hil_theta_e;
            // Tratamento trigonométrico do ângulo
            if (theta_feedback > M_PI_F) theta_feedback -= 2.0f * M_PI_F;
            if (theta_feedback < -M_PI_F) theta_feedback += 2.0f * M_PI_F;
            // 4. Transformadas e CORDIC
            float cos_th, sin_th;
            CORDIC_Calcula_Seno_Cosseno(theta_feedback, &sin_th, &cos_th);
            float i_alpha = ia_med;
            float i_beta  = -(ia_med + 2.0f * ib_med) / 1.7320508f;
            float iqx =  i_alpha * cos_th - i_beta * sin_th;
            float idx =  i_alpha * sin_th + i_beta * cos_th;
            float id = idx;
            float iq = iqx;
            // 5. Integração
            float erro_we = we_ref_f - we_feedback;
            z_int_we += erro_we;
            z_int_id += (0.0f - id);
            // 6. Equações de Ganho do MPC
            float u_mpc_q = -(KX[0][0]*iq + KX[0][1]*id + KX[0][2]*we_feedback)
                            + KZ[0][0]*z_int_we + KZ[0][1]*z_int_id
                            + KR[0][0]*we_ref_f;
            float u_mpc_d = -(KX[1][0]*iq + KX[1][1]*id + KX[1][2]*we_feedback)
                            + KZ[1][0]*z_int_we + KZ[1][1]*z_int_id
                            + KR[1][0]*we_ref_f;
            // 7. Saturação com Anti-Windup (Back-calculation)
            float vq_refx = u_mpc_q;
            float vd_refx = u_mpc_d;
            if (vq_refx > VMAX_MPC){
                vq_refx = VMAX_MPC;
                z_int_we -= erro_we;
                z_int_id -= -id;
            } else if (vq_refx < -VMAX_MPC){
                vq_refx = -VMAX_MPC;
                z_int_we -= erro_we;
                z_int_id -= -id;
            }
            if (vd_refx > VMAX_MPC){
                vd_refx = VMAX_MPC;
                z_int_we -= erro_we;
                z_int_id -= -id;
            } else if (vd_refx < -VMAX_MPC){
                vd_refx = -VMAX_MPC;
                z_int_we -= erro_we;
                z_int_id -= -id;
            }
            float vq_ref = vq_refx;
            float vd_ref = vd_refx;
            vq_ref_ant = vq_ref;
            vd_ref_ant = vd_ref;
            // 8. Transformada Inversa e Exportação
            float valpha_ref = vq_ref * cos_th + vd_ref * sin_th;
            float vbeta_ref  = -vq_ref * sin_th + vd_ref * cos_th;
            float valfa_norm = valpha_ref / VMAX_MPC;
            float vbeta_norm = vbeta_ref  / VMAX_MPC;
            uint32_t dac_valfa = (uint32_t)(2048.0f + (valfa_norm * 2047.0f));
            uint32_t dac_vbeta = (uint32_t)(2048.0f + (vbeta_norm * 2047.0f));
            if(dac_valfa > 4095) dac_valfa = 4095;
            if(dac_vbeta > 4095) dac_vbeta = 4095;
            saidas_dac[0] = dac_valfa;
            saidas_dac[1] = dac_vbeta;
            Atualiza_Sinais_DAC(saidas_dac);

        } else {
            // MODO: ESPERA / PARADO (Sinal PC13 em LOW)
            // LED Heartbeat Rápido (Pisca a cada 100ms = 1000 ciclos)
            static uint32_t contador_led_stop = 0;
            contador_led_stop++;
            if(contador_led_stop >= 1000) {
                HAL_GPIO_TogglePin(GPIOA, GPIO_PIN_5);
                contador_led_stop = 0;
            }
            // Limpeza das Memórias (Reseta os integradores e filtros)
            z_int_we = 0.0f;
            z_int_id = 0.0f;
            wm_ref_f = 0.0f;
            vq_ref_ant = 0.0f;
            vd_ref_ant = 0.0f;
            // Travar as saídas no eixo neutro (1.65V = 2048) -> Inversor com 0V de comando
            saidas_dac[0] = 2048;
            saidas_dac[1] = 2048;
            Atualiza_Sinais_DAC(saidas_dac);
        }
    }
}

